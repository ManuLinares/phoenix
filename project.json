{
  "langrev": "1",
  "warnings":  [ "no-unused" ],
  "dependency-search-paths":  [ "lib" ],
  "dependencies":  [ "raylib6" ],
  "authors":  [ "Syn9" ],
  "version": "1.0.0",
  "sources":  [ "src/**" ],
  "output": "build",
  "targets": {
    "phoenix": {
      "type": "executable"
    },
    "web": {
      "type": "executable",
      "name": "index.html",
      "target": "emscripten",
      "link-args": [
        //"--preload-file resources/img@resources/img",
        "-sASYNCIFY",
        "-sALLOW_MEMORY_GROWTH=1",
        "-sUSE_WEBGL2=1",
        "--shell-file src/minshell.html"
      ]
    }
  },
  "cpu": "generic",
  "opt": "O0"
}